# Bash-only overrides for a direct Python process; source after the generated .env.
# The generated BRIDGE_CONFIG_FILE names the actual config.json on this host.
BRIDGE_CONFIG="${BRIDGE_CONFIG_FILE:?Load the generated private .env first}"
# Replace this whole URL with your pre-existing PostgreSQL role/database/host.
# Percent-encode reserved characters in URL credentials; use your provider's TLS options.
DATABASE_URL='postgresql+psycopg://REPLACE_USER:REPLACE_URL_ENCODED_PASSWORD@127.0.0.1:5432/REPLACE_DATABASE'
