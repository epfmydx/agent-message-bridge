# Manual common/Compose template. Prefer scripts.setup_runtime for generated private files.
# Empty credentials are placeholders; this file is not ready to run unchanged.
# Direct Python processes also need the host overrides in direct.env.example.
BASE_URL=https://bridge.example.com
DATABASE_URL=
SESSION_SECRET=
ENCRYPTION_KEY=
# BRIDGE_CONFIG is the container path; *_FILE values below are paths on the Docker host.
BRIDGE_CONFIG=/run/bridge/config.json
POSTGRES_PASSWORD=
BRIDGE_ENV_FILE=/private/path/agent-message-bridge/.env
BRIDGE_CONFIG_FILE=/private/path/agent-message-bridge/config.json
BRIDGE_ADMIN_ENV_FILE=/private/path/agent-message-bridge/admin.env
AGENT_A_API_KEY=
AGENT_B_PASSWORD_HASH=
OWNER_PASSWORD_HASH=
WEBHOOK_URL=
WEBHOOK_TOKEN=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
